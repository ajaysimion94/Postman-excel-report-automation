COLLECTIONS_DIR=/absolute/path/to/your/collections
FILTERS_DIR=/absolute/path/to/your/filters

# Optional runtime safety
# Per-request HTTP read timeout in seconds (default: 30)
REQUEST_TIMEOUT_SECONDS=30
# Maximum response body size kept in memory for data-sheet parsing, in MB (default: 10)
MAX_RESPONSE_MB=10

# Auth defaults (fallbacks — the UI can override these)
#
# RECOMMENDED: Use the --config command instead of storing credentials here.
# It saves credentials in an AES-256-GCM encrypted file (~/.config/postman-automation/credentials.enc)
# and supports multiple named profiles:
#
#   java -jar app.jar --config                      # Add / update a profile (interactive)
#   java -jar app.jar --config --show               # List all profiles
#   java -jar app.jar --config --switch <name>      # Switch active profile
#   java -jar app.jar --config --delete <name>      # Delete a profile
#
# These are FALLBACKS. Authentication selected for a request in the web UI (the
# Authorization tab) or defined on the request in the collection JSON always wins
# over them, so a credential typed in the UI is never silently ignored.
#
# Credential priority (highest → lowest):
#   1. Request auth from the UI / collection JSON   ← wins whenever it is set
#   2. Filter auth overrides (from filter JSON files)
#   3. Credential store active profile  ← managed via --config
#   4. Values in this .env file         ← fallback / plain-text (less secure)
#   5. System environment variables
#
# Secret values may also be stored from the web UI (Authorization tab → Secret
# vault). They are written to .web-state/secrets.enc in the workspace, encrypted
# with AES-256-GCM, and referenced from a request as {{NAME}}.
#
API_USERNAME=my-user
API_PASSWORD=my-password
BEARER_TOKEN=my-token
API_KEY=my-api-key
APIKEY_HEADER=X-API-Key

DISABLE_SSL_VERIFY=true

# Report file pattern
OUTPUT_FILE=/absolute/path/to/reports/{collection}_{timestamp}.xlsx