COLLECTIONS_DIR=/absolute/path/to/your/collections
FILTERS_DIR=/absolute/path/to/your/filters

# Optional runtime safety
# Per-request HTTP read timeout in seconds (default: 30)
REQUEST_TIMEOUT_SECONDS=30
# Maximum response body size kept in memory for data-sheet parsing, in MB (default: 10)
MAX_RESPONSE_MB=10

# Auth defaults (filters can override these)
API_USERNAME=my-user
API_PASSWORD=my-password
BEARER_TOKEN=my-token
API_KEY=my-api-key
APIKEY_HEADER=X-API-Key

# Report file pattern
OUTPUT_FILE=/absolute/path/to/reports/{collection}_{timestamp}.xlsx