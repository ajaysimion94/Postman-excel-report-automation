{
  "_comment": "Example: filter rows modified yesterday using a date field. Replace modifiedDate with your actual date field name.",

  "collection": "jsonplaceholder",
  "requests": ["List all posts"],

  "rowFilters": {
    "*": {
      "logic": "AND",
      "rules": [
        {
          "field": "modifiedDate",
          "op":    "DATE_PRESET",
          "value": "YESTERDAY"
        }
      ]
    }
  },

  "dateConfig": {
    "*": {
      "modifiedDate": {
        "format":   "yyyy-MM-dd'T'HH:mm:ss'Z'",
        "timezone": "UTC"
      }
    }
  },

  "customTables": [
    {
      "name": "Yesterday Modified (enabled only)",
      "sourceRequest": "List all posts",
      "columns": ["id", "title", "modifiedDate"],
      "where": {
        "logic": "AND",
        "rules": [
          {
            "field": "modifiedDate",
            "op":    "DATE_PRESET",
            "value": "YESTERDAY"
          },
          {
            "field": "enabled",
            "op":    "IS_TRUE"
          }
        ]
      }
    },
    {
      "name": "This Month (custom date range)",
      "sourceRequest": "List all posts",
      "columns": ["id", "title", "modifiedDate"],
      "where": {
        "logic": "AND",
        "rules": [
          {
            "field": "modifiedDate",
            "op":    "DATE_PRESET",
            "value": "THIS_MONTH"
          }
        ]
      }
    }
  ],

  "outputPrefix": "date-filtered"
}
