{
  "collection": "jsonplaceholder",
  "requests": ["Get post by ID"],

  "responseColumns": {
    "*": ["id", "title", "body", "userId"]
  },

  "rowFilters": {
    "Get post by ID": {
      "logic": "AND",
      "rules": [
        { "field": "userId", "op": "EQ", "value": "1" }
      ]
    }
  },

  "outputPrefix": "daily"
}
