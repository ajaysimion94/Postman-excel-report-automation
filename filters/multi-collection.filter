# Multi-collection .filter sample
# Use --collection-name or --collection when running this file.

# Shared defaults applied to whichever collection block is selected
SHAPE "*" LIMIT 200;

COLLECTION posts;
REQUESTS "List posts", "Get post by ID";
FILTER "List posts" WHERE id > 10;
COLUMNS "List posts": id, title, userId;

COLLECTION users;
REQUESTS "List users", "Get user by ID";
FILTER "List users" WHERE id > 100;
COLUMNS "List users": id, name, email;

COLLECTION comments;
REQUESTS "List comments";
FILTER "List comments" WHERE postId IN (1,2,3);
COLUMNS "List comments": id, postId, email, body;
