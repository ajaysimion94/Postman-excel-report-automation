# INTERSECT Example — find common rows across requests
#
# Creates a sheet containing only rows that exist in ALL specified sources.
# Useful for: finding records that appear in multiple API endpoints.
#
# Output columns:
#   all original fields + _source (always "ALL") + _in_<req> per source (always true)

COLLECTION jsonplaceholder;
REQUESTS "List posts", "List users";
OUTPUT_PREFIX intersect-example;

FILTER "List posts" WHERE userId = 1;
COLUMNS "List posts": id, userId, title;

# Rows present in both "List posts" AND "List users"
INTERSECT CommonRows FROM "List posts", "List users";

# Apply shape to the intersect output
SHAPE "CommonRows" ORDER BY id ASC;
