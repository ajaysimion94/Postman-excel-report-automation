# ──────────────────────────────────────────────────────────────────────────────
# IF/ELSE Conditional Demo
#
# This filter demonstrates IF/ELSE in two contexts:
#   1. WHERE clauses — conditional row filtering logic
#   2. Summary text — conditional rendering in KV, LV, TEXT, and QT
#
# Uses the jsonplaceholder collection.
# ──────────────────────────────────────────────────────────────────────────────

COLLECTION jsonplaceholder;
REQUESTS "List all posts", "List all todos";

# ──────────────────────────────────────────────────────────────────────────────
# 1. IF/ELSE IN WHERE CLAUSES
# ──────────────────────────────────────────────────────────────────────────────

# Apply different severity thresholds depending on userId
# If userId is 1, only keep rows where id > 5
# Otherwise, only keep rows where id > 50
FILTER "List all posts" WHERE IF userId = 1 THEN (id > 5) ELSE (id > 50);

# IF without ELSE: only filter when condition is true
# When completed IS TRUE, the title must contain "aut"; otherwise, row passes
FILTER "List all todos" WHERE IF completed IS TRUE THEN (title CONTAINS aut);

# IF/ELSE nested inside AND: both the conditional AND the category must match
# FILTER "List all posts" WHERE IF userId = 1 THEN (id > 5) ELSE (id > 50) AND title CONTAINS qui;

# ──────────────────────────────────────────────────────────────────────────────
# 2. IF/ELSE IN SUMMARY TEXT EXPRESSIONS
# ──────────────────────────────────────────────────────────────────────────────

$POSTS = FILTER "List all posts" WHERE userId = 1;
$TODOS = FILTER "List all todos" WHERE completed IS TRUE;

# ── Simple conditional in KV ──────────────────────────────────────────────────
KV "Post Status" IF $POSTS > 0 THEN $POSTS + " found" ELSE "No posts found";

# ── Nested IF/ELSE for multi-level logic ──────────────────────────────────────
KV "Volume" IF $POSTS > 500 THEN "Very High" ELSE IF $POSTS > 100 THEN "High" ELSE IF $POSTS > 10 THEN "Medium" ELSE "Low";

# ── Conditional in LV ─────────────────────────────────────────────────────────
LV "Todo Health" IF $TODOS > 50 THEN "Good completion rate" ELSE "Needs attention";

# ── Conditional in TEXT ────────────────────────────────────────────────────────
TEXT IF $POSTS > 0 THEN $POSTS + " posts matched the filter" ELSE "No posts matched";

# ── Conditional in multi-column QuickTable ─────────────────────────────────────
QT "Assessment" HEADERS Metric, Count, Assessment
  ROW "Posts",    $POSTS, IF $POSTS > 100 THEN "High volume" ELSE "Low volume"
  ROW "Todos",    $TODOS, IF $TODOS > 50 THEN "Good" ELSE "Needs work";

# ── Show metrics and per-request status ────────────────────────────────────────
STATUS;
METRICS;
