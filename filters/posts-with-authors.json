{
  "collection": "jsonplaceholder",
  "requests": ["List all posts", "List users"],

  "responseColumns": {
    "*": ["id", "title", "userId"]
  },

  "rowFilters": {
    "List all posts": {
      "logic": "AND",
      "rules": [
        { "field": "userId", "op": "IN",  "value": "1,2,3" }
      ]
    },
    "List users": {
      "logic": "AND",
      "rules": [
        { "field": "id", "op": "IN", "value": "1,2,3" }
      ]
    }
  },

  "customTables": [
    {
      "name": "Posts with Author Names",
      "sources": [
        { "request": "List all posts", "as": "p" },
        { "request": "List users",     "as": "u" }
      ],
      "joinOn": [{ "leftField": "userId", "rightField": "id" }],
      "columns": ["p.id", "p.title", "u.name", "u.email"],
      "where": {
        "logic": "AND",
        "rules": [
          { "field": "u.name", "op": "NOT_CONTAINS", "value": "Deleted" }
        ]
      }
    }
  ],

  "outputPrefix": "posts-with-authors"
}
