# EXCEPT Example — find rows only in the first source
#
# Creates a sheet with rows from the first source that are NOT present
# in any subsequent source.
# Useful for: finding what was added/created in one source vs another.
#
# Output columns:
#   all original fields + _source (<first_source>) + _in_<req> per source

COLLECTION jsonplaceholder;
REQUESTS "List posts", "List archived posts";
OUTPUT_PREFIX except-example;

COLUMNS "List posts": id, userId, title;
COLUMNS "List archived posts": id, userId, title;

# Rows in "List posts" that are NOT in "List archived posts"
# (e.g., active posts that haven't been archived yet)
EXCEPT ActivePosts FROM "List posts", "List archived posts";

SHAPE "ActivePosts" ORDER BY id DESC;
