# Tutorial .filter file
# Copy this file and adjust request names/fields to your collection.

# 1) Pick collection and baseline requests
COLLECTION jsonplaceholder;
REQUESTS "List posts", "List users";

# 2) Optional output naming
OUTPUT_PREFIX tutorial-run;

# 3) Base row filtering with nested logic and NOT
FILTER "List posts" WHERE (userId IN (1,2,3) OR title LIKE '%guide%') AND NOT archived IS TRUE;

# 4) Column projection for response-data sheets
COLUMNS "List posts": id, userId, title, body;
COLUMNS "List users": id, name, email;
COLUMNS *: id;

# 5) Date parsing + date filter
DATE_CONFIG "List posts".createdAt FORMAT yyyy-MM-dd'T'HH:mm:ss'Z' TIMEZONE UTC;
FILTER "List posts" WHERE createdAt DATE_PRESET THIS_MONTH;

# 6) Row shaping: DISTINCT + ORDER + pagination
SHAPE "List posts" DISTINCT ORDER BY id DESC LIMIT 100 OFFSET 0;

# 7) Grouping + aggregate + having
# Produces grouped rows for List posts response-data sheet.
SHAPE "List posts"
  GROUP BY userId
  AGG COUNT(*) AS post_count, MAX(id) AS latest_post_id
  HAVING post_count > 1
  ORDER BY post_count DESC;

# 8) Union examples (creates dedicated union sheets)
UNION "PostsAndUsersDistinct" FROM "List posts", "List users";
UNION "PostsAndUsersAll" FROM "List posts", "List users" ALL;

# 9) Apply shape to a union output sheet
SHAPE "PostsAndUsersDistinct" ORDER BY id ASC LIMIT 200;

# NOTE:
# - If your collection does not contain these request names, replace them.
# - If fields like archived or createdAt do not exist in your API, remove/edit those rules.

# 10) Multi-collection blocks in one file (advanced)
# If you keep multiple COLLECTION blocks, run with --collection-name or --collection.
#
# COLLECTION posts;
# REQUESTS "List posts";
# FILTER "List posts" WHERE id > 10;
#
# COLLECTION users;
# REQUESTS "List users";
# FILTER "List users" WHERE id > 100;
