# COMPARE Example — column value matrix across sources
#
# Creates a sheet showing each unique value of a specified field
# with boolean columns per source and a count column.
# Useful for: seeing which values of a key field exist in which sources.
#
# Output columns: <field> | _in_<source1> | _in_<source2> | ... | _count

COLLECTION my-collection;   # TEMPLATE: replace with your collection; the request and field names below are placeholders
REQUESTS "List posts", "List archived posts", "List users";
OUTPUT_PREFIX compare-example;

COLUMNS "List posts": id, userId, title;
COLUMNS "List archived posts": id, userId, title;
COLUMNS "List users": id, name, email;

# Compare userId values across all three sources
# Shows: which user IDs appear in which endpoints
COMPARE UserIdCompare ON id FROM "List posts", "List archived posts", "List users";

# Compare userId values between just posts and archived posts
COMPARE PostUserIdCompare ON userId FROM "List posts", "List archived posts";

# Compare with WHERE — only rows where userId <= 3
COMPARE LimitedUserIdCompare ON userId FROM "List posts", "List archived posts" WHERE userId <= 3;

# Sort by value
SHAPE "UserIdCompare" ORDER BY id ASC;
SHAPE "PostUserIdCompare" ORDER BY userId ASC;
