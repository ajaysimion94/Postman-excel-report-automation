{
  "collection": "jsonplaceholder",
  "requests": ["List all posts", "Get post by ID"],

  "responseColumns": {
    "*":              ["id", "title", "userId"],
    "Get post by ID": ["id", "title", "body", "userId"]
  },

  "rowFilters": {
    "*": {
      "logic": "AND",
      "rules": [
        { "field": "userId", "op": "LTE", "value": "5" }
      ]
    }
  },

  "customTables": [
    {
      "name": "Posts by user 1",
      "sourceRequest": "List all posts",
      "columns": ["id", "title", "userId"],
      "where": {
        "logic": "AND",
        "rules": [
          { "field": "userId", "op": "EQ", "value": "1" }
        ]
      }
    }
  ],

  "outputPrefix": "posts-focus"
}
