# ──────────────────────────────────────────────────────────────────────────────
# STATUS, Multi-Column QT, and Hex Color Demo
#
# This filter demonstrates:
#   1. STATUS keyword — per-request status table on the Summary sheet
#   2. Multi-column QuickTable — 3+ columns with comma-separated ROW values
#   3. Hex RGB colors — custom colors using #RRGGBB notation
#
# Uses the jsonplaceholder collection.
# ──────────────────────────────────────────────────────────────────────────────

COLLECTION jsonplaceholder;
REQUESTS "List all posts", "List all users", "List all todos";

# ── Data shaping ───────────────────────────────────────────────────────────────
FILTER "List all posts" WHERE userId = 1;
COLUMNS "List all posts": id AS "Post ID", userId AS "User", title AS "Title";

# ── Summary variables ──────────────────────────────────────────────────────────
$POSTS    = FILTER "List all posts" WHERE userId = 1;
$ALL      = FILTER "List all posts" WHERE userId >= 1;
$DONE     = FILTER "List all todos" WHERE completed IS TRUE;
$PENDING  = FILTER "List all todos" WHERE completed IS FALSE;

# ═══════════════════════════════════════════════════════════════════════════════
# SUMMARY PAGE
# ═══════════════════════════════════════════════════════════════════════════════

# ── Hex color banners ──────────────────────────────────────────────────────────
# Any #RRGGBB hex color works — no need to pick from a limited palette
TITLE "Dashboard" COLOR "#0B5345";          # Dark teal
DESCRIPTION "Daily report" COLOR "#1B4F72"; # Dark blue

# ── Multi-column QuickTable (4 columns) ────────────────────────────────────────
# Each ROW provides comma-separated values, one per header column
QT "KPI Summary" HEADERS Category, Total, Completed, Status
  ROW "Posts",  $ALL,  $POSTS, IF $POSTS > 0 THEN "OK" ELSE "Missing"
  ROW "Todos",  $DONE, $DONE,  IF $DONE > 50 THEN "Good" ELSE "Low";

# ── Multi-column QuickTable (5 columns) ────────────────────────────────────────
QT "Health Check" HEADERS Service, Available, Status, Uptime, Grade
  ROW "Posts API",   $ALL,     IF $ALL > 0 THEN "Up" ELSE "Down",   "99.9%", "A"
  ROW "Users API",  "yes",     "Up",                                 "99.5%", "A"
  ROW "Todos API",  $DONE,     IF $DONE > 0 THEN "Up" ELSE "Down", "98.0%", "B";

# ── Classic 2-column QuickTable ────────────────────────────────────────────────
QT "Counts" HEADERS "Metric", "Value"
  ROW "User 1 Posts" $POSTS
  ROW "All Posts" $ALL
  ROW "Completed Todos" $DONE;

# ── STATUS — per-request status table ──────────────────────────────────────────
# Shows each request with: name, method, status code, success, duration
# Color the section header with a custom hex color
STATUS COLOR "#228B22";

# ── STATUS with named color ─────────────────────────────────────────────────────
# You can also use named colors instead of hex
# STATUS COLOR DARK_GREEN;

# ── Conditional text with IF/ELSE ──────────────────────────────────────────────
KV "Result" IF $POSTS > 0 THEN $POSTS + " posts found" ELSE "No posts found";

# ── Metrics ─────────────────────────────────────────────────────────────────────
METRICS;
